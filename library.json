{
  "$schema": "https://raw.githubusercontent.com/platformio/platformio-core/develop/platformio/assets/schema/library.json",
  "name": "KymoCore",
  "version": "7.3.2",
  "description": "Portable heap-free C++11 telemetry with a C API, optional modular Endpoint, shared transport, live variables, parameters, memory metrics and execution tracing. Hardware-neutral callbacks for Arduino, ESP32, STM32 and more.",
  "keywords": [
    "kymotrace",
    "telemetry",
    "sensor",
    "data-logging",
    "serial",
    "binary-protocol",
    "arduino",
    "esp32",
    "stm32"
  ],
  "authors": [
    {
      "name": "Christof Seidel",
      "maintainer": true
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/KymoTrace/kymocore.git"
  },
  "license": "MIT",
  "homepage": "https://kymotrace.de",
  "frameworks": "*",
  "platforms": "*",
  "headers": [
    "KymoCore.h"
  ],
  "examples": [
    {
      "name": "Portable Init/Main",
      "base": "examples/basic",
      "files": [
        "main.cpp",
        "README.md"
      ]
    },
    {
      "name": "multi sensor example",
      "base": "examples/arduino/multi_sensor_example",
      "files": [
        "platformio.ini",
        "README.md"
      ]
    },
    {
      "name": "simple analog example",
      "base": "examples/arduino/simple_analog_example",
      "files": [
        "platformio.ini",
        "README.md"
      ]
    }
  ],
  "export": {
    "include": [
      "src",
      "examples",
      "docs/images",
      "docs/README.md",
      "docs/ENDPOINT.md",
      "docs/GUIDE.md",
      "docs/GUIDE.de.md",
      "docs/TRACE_PROTOCOL.md",
      "tools/configurator",
      "LICENSE",
      "docs/CONTRIBUTING.md",
      "docs/CONTRIBUTING.de.md",
      "CHANGELOG.md",
      "docs/PUBLISHING.md",
      "README.md",
      "README.de.md",
      "docs/PROTOCOL.md",
      "library.properties",
      "docs/COMPILE_OUT.md"
    ],
    "exclude": [
      "**/.pio/**",
      "**/.vscode/**",
      "**/__pycache__/**",
      "**/.pytest_cache/**",
      "**/*.pyc",
      "**/*.egg-info/**"
    ]
  },
  "build": {
    "srcDir": "src",
    "includeDir": "src",
    "flags": [
      "-std=c++11",
      "-fno-exceptions",
      "-fno-rtti"
    ]
  }
}
